import random
suits=["Hearts","Diamonds","Spades","Clubs"]
lists=["Ace","2","3","4","5","6","7","8","9","10","Jack","Queen","King"]
deck=[(card, category) for category in suits for card in lists]

def drawcard(x):
    return x.pop()

def main():
    print("Welcome to Blackjack!")
    print("\nDo you need to learn how to play?")
    print("Yes or No: ", end="")
    answer=input().lower()
    while answer!="yes" and answer!="y" and answer!="no" and answer!="n":
        answer=input("Please input your answer properly: ").lower()
    if answer=="yes" or answer=="y":
        instructions()
    elif answer=="no" or answer=="n":
        print("Lets get started!")
    bet_money = eval(input("\nHow much money would you like to bring to the table?: "))
    initial=bet_money
    main2(bet_money,initial)

def main2(bet_money,initial):
    bet=eval(input("\nHow much money would you like bet?: "))
    while bet>bet_money:
        bet = eval(input("\nYou can't bet more than you put in. How much money would you like bet?: "))
    random.shuffle(deck)
    play(bet_money,bet,initial)

def play(bet_money,bet,initial):
    playershand=[]
    dealershand=[]

    for x in range(2):
        playershand.append(drawcard(deck))
        dealershand.append(drawcard(deck))
    print("\nPlayers hand: ", playershand)
    print("You have: ",handvalue(playershand))
    answer=""
    if handvalue(playershand)==21:
        input("Wow! Lucky! No need to hit! Press Enter to see the dealers hand!")
    else:
        print("Hit or Stand? ", end="")
        answer=input().lower()
        while answer!="hit" and answer!="h" and answer!="s" and answer!="stand":
            print("Make sure you type properly. Hit or Stand? ", end="")
            answer = input().lower()

    while answer=="hit" or answer=="h":
        drawcard(deck)
        playershand.append(drawcard(deck))
        print("You drew: ",playershand[-1])
        print("You have: ",handvalue(playershand))
        if handvalue(playershand)<21:
            print("Hit or Stand? ", end="")
            answer=input().lower()
        elif handvalue(playershand)==21:
            print("Congrats! You got 21!")
            input("Press 'Enter' to see the dealer's hand")
            break
        else:
            check(playershand, dealershand,bet_money,bet,initial)
            return
    print("\nDealer's turn: ")
    print("Dealer's hand: ",dealershand)
    print("Dealer has: ",handvalue(dealershand))

    while handvalue(dealershand)<17:
        drawcard(deck)
        dealershand.append(drawcard(deck))
        print("Dealer had less than 17 and was required to draw another card.")
        print("Dealer drew: ", dealershand[-1])
        print("Dealer now has: ",handvalue(dealershand))
    if handvalue(dealershand)>21:
            print("The dealer has more than 21!")
    if handvalue(dealershand)==21:
            print("Oh no! The dealer has 21!")
    check(playershand, dealershand,bet_money,bet,initial)

def check(playershand,dealershand,bet_money,bet,initial):
    phv=handvalue(playershand)
    dhv=handvalue(dealershand)
    if phv>dhv and phv<=21:
        print("\nCongrats! You beat the dealer!")
        status="w"
    elif phv<dhv and dhv<=21:
        print("\nOh no! You lost to the dealer! Better luck next time.")
        status="l"
    elif phv>21:
        print("\nOh no! You have more than 21! You lose!")
        status="l"
    elif dhv>21:
        print("\nThe dealer has more than 21! You win!")
        status="w"
    else:
        print("\nYou pushed on the dealers hand so you keep your bet")
        status="t"
    betting(status,bet_money,bet,initial)
def cardvalues(card):

    if card[0] in ["Jack","Queen","King"]:
        value=10
    elif card[0]=="Ace":
        value=11
    else:
        value=int(card[0])
    return value

def handvalue(hand):
    totalvalue=0
    for card in hand:
        totalvalue+=cardvalues(card)
    return totalvalue
def betting(status,bet_money,bet,initial):
    while bet_money!=0:
        if status=="w":
            restart=input("Do you want to go for another round? Yes or No: ").lower()
            bet_money+=bet
        elif status=="t":
            restart=input("Do you want to go for another round? Yes or No: ").lower()
        else:
            restart=input("Do you want to go for another round? Yes or No: ").lower()
            bet_money=bet_money-bet
        while restart!="yes" and restart!="y" and restart!="no" and restart!="n":
            restart = input("Make sure you typed everything properly."
                            "Do you want to go for another round? Yes or No: ").lower()
        if bet_money!=0 and (restart=="yes" or restart=="y"):
            main2(bet_money,initial)
            return
        else:
            print("Thanks for playing!")
    if bet_money==0:
        print("Sorry you lost all your money! Better luck next time!")
    else:
        print("You initially put in:",initial,"\nYou now have:",bet_money)
        if initial>bet_money:
            print("Sorry for your losses. Better luck next time")
        else:
            print("Congrats! Most people lose money but you didn't!")

