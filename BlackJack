def hand_value(hand):
    total_value=0
    num_aces=0
    for card in hand:
        if card[0] == "Ace":
            total_value += 11  # Temporarily count Ace as 11
            num_aces += 1
        elif card[0] in ["King", "Queen", "Jack"]:
            total_value += 10  # Face cards are worth 10
        else:
            total_value += int(card[0])  # Other cards are worth their face value
        # Adjust for Aces if necessary (if total value exceeds 21, change Aces from 11 to 1)
    while total_value > 21 and num_aces > 0:
        total_value -= 10  # Change one Ace from 11 to 1
        num_aces -= 1
    return total_value

def check(players_hand, dealers_hand, bet_money, bet, initial):
    phv=hand_value(players_hand)
    dhv=hand_value(dealers_hand)
    if phv>dhv and phv<=21:
        print("\nCongrats! You beat the dealer!")
        status="w"
    elif phv<dhv and dhv<=21:
        print("\nOh no! You lost to the dealer! Better luck next time.")
        status="l"
    elif phv>21:
        print("\nOh no! You have more than 21! You lose!")
        status="l"
    elif dhv>21:
        print("\nThe dealer has more than 21! You win!")
        status="w"
    else:
        print("\nYou pushed on the dealers hand so you keep your bet")
        status="t"
    betting(status,bet_money,bet,initial)

def betting(status,bet_money,bet,initial):
    while bet_money!=0:
        if status=="w":
            restart=input("Do you want to go for another round? Yes or No: ").lower()
